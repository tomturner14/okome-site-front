# Example environment variables for local development.
# Do not put real secrets, real tokens, or production-only values here.

# Backend API origin used by Next.js rewrites.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Frontend site origin used when Server Components need an absolute URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Use localStorage cart in local development.
# "1" = local cart, other values = API cart.
NEXT_PUBLIC_USE_LOCAL_CART=1
